// Artifact Library — data model.
//
// Access model: a user only ever sees items in projects they are a member of.
// Within a project, an item marked `restricted` is visible only to the users it
// has been explicitly granted to (plus admins). Admins see everything and are
// the only ones who can create users, projects, and items.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  role         String          @default("member") // "admin" | "member"
  memberships  ProjectMember[]
  itemGrants   ItemGrant[]
  comments     Comment[]
  sessions     Session[]
  createdAt    DateTime        @default(now())
}

model Session {
  token     String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
}

model Project {
  id          String          @id @default(cuid())
  slug        String          @unique
  name        String
  description String          @default("")
  members     ProjectMember[]
  items       Item[]
  createdAt   DateTime        @default(now())
}

model ProjectMember {
  id        String  @id @default(cuid())
  userId    String
  projectId String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
}

model Item {
  id          String      @id @default(cuid())
  projectId   String
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String      @default("")
  // "note" | "image" | "google_doc" | "google_sheet" | "google_slides" | "html" | "link"
  kind        String
  /// External kinds: the Google/other URL. Kind "image": either a URL or, for an
  /// uploaded file, a data: URI holding the image itself.
  url         String      @default("")
  htmlContent String      @default("") // kind "html": the page itself, stored in the DB
  /// Kind "note": what you typed, as Markdown. Kept as source rather than
  /// rendered HTML so it stays editable and searchable as the words you wrote.
  body        String      @default("")
  // "debrief" | "idea" | "best_practice" | "research" | "presentation" | "other"
  category    String      @default("other")
  restricted  Boolean     @default(false) // true: only granted users (and admins) see it
  grants      ItemGrant[]
  tags        ItemTag[]
  comments    Comment[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model ItemGrant {
  id     String @id @default(cuid())
  itemId String
  userId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([itemId, userId])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  items ItemTag[]
}

model ItemTag {
  id     String @id @default(cuid())
  itemId String
  tagId  String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([itemId, tagId])
}

/// One note from one person. Threads are flat: every note carries the thread
/// number shown in the page margin, so a reply is another row with the same
/// number. That mirrors the spreadsheet a reviewer sorts through, and makes the
/// CSV export a straight dump rather than a reconstruction.
///
/// A note with quotedText is anchored to words inside an HTML item; one without
/// is general comment on the item as a whole, which is all that is possible for
/// a Google Doc or a link.
model Comment {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Stable per item, and never reused — the number readers see in the margin.
  thread Int
  body   String
  /// "open" | "resolved". Carried on every note in the thread, as the sheet does.
  status String @default("open")

  /// Nearest heading, so comments can be grouped by part of a document.
  section String @default("")

  /// The anchor: the highlighted words, plus context either side used to find
  /// them again after the page is edited. Empty for a whole-item comment.
  quotedText String @default("")
  prefix     String @default("")
  suffix     String @default("")

  createdAt DateTime @default(now())

  @@index([itemId, thread])
}
