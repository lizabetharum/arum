# Supabase Postgres. Dashboard → Connect → ORMs (or Connection string → URI).
# Pooled (transaction, port 6543) — what the app runs on:
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct (session, port 5432) — used by prisma db push / migrations:
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# Used only by `npm run db:seed` to create the first admin account.
ADMIN_EMAIL="lizarum@gmail.com"
ADMIN_PASSWORD="pick-a-strong-password"
